Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 35; 35; 35
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
    - Class: rviz/MarkerArray
      Name: Obstacles
      Enabled: true
      Marker Topic: /humanoid/obstacles
    - Class: rviz/MarkerArray
      Name: Body and CoM
      Enabled: true
      Marker Topic: /humanoid/body
    - Class: rviz/Path
      Name: CoM path and orientations
      Enabled: true
      Topic: /humanoid/path
      Color: 255; 170; 0
      Pose Style: Axes
      Pose Axis Length: 0.2
      Pose Axis Radius: 0.02
      Line Style: Lines
      Line Width: 0.03
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 7
      Pitch: 0.6
      Yaw: 0.8
      Focal Point: {X: 0, Y: 0, Z: 0.6}
